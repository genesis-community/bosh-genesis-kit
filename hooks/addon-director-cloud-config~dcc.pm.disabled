#!/usr/bin/env perl
package Genesis::Hook::Addon::BOSH::DirectorCloudConfig v3.1.0;

use strict;
use warnings;

# Only needed for development
BEGIN {push @INC, $ENV{GENESIS_LIB} ? $ENV{GENESIS_LIB} : $ENV{HOME}.'/.genesis/lib'}

use parent qw(Genesis::Hook::Addon);

# Give us the bosh and credhub functions that target this director instead of
# parent director
require File::Basename; require Cwd;
require(File::Basename::dirname(Cwd::abs_path(__FILE__)).'/lib/BoshDirectorAccess.pm');
BoshDirectorAccess->import();

use Genesis qw/info output/;
use Genesis::Term qw/terminal_width render_markdown decolorize/;
use JSON::PP;

sub init {
	my $class = shift;
	my $obj = $class->SUPER::init(@_);
	$obj->check_minimum_genesis_version('3.1.0-rc.9');
	return $obj;
}

sub cmd_details {
  return "\nGenerate and upload the cloud config for this director, which specifies ".
		"\nthe azs and the complilation config, including its network, vm type, etc.".
		"\n".
		"\nOptions:\n".
		"\n[[  #y{-n}      >>Dry run, just print out the director cloud config ".
		                  "without uploading it.\n".
		"\n[[  #y{-y}      >>Upload changes without prompting for confirmation.\n".
		"\n[[  #y{-R}      >>Remove the director cloud config from the director ".
		                  "instead.\n";
}

sub perform {
